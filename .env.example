# Web3Forms access keys.
#
# Generate at https://web3forms.com. Each key belongs to one Web3Forms form,
# and a form's recipient mailbox is set in its dashboard — so routing enquiries
# to different mailboxes means one Web3Forms form per mailbox.
#
# Set these in Vercel's Environment Variables (Production + Preview) and in a
# local .env.local for development. Never commit real keys.
#
# NOTE: NEXT_PUBLIC_ values are inlined at BUILD time. Adding or changing one
# after a deployment requires a redeploy before it takes effect. Paste values
# carefully — a stray leading tab or trailing newline makes Web3Forms reject
# the key as a malformed UUID.

# Required. The general contact form, and the fallback for every route below.
# Recipient: info@invisionsolutions.co.uk
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional per-mailbox keys used by /enquiries. Any that are left unset fall
# back to the key above, so the page works before these forms exist and gets
# more precise as each one is created.
NEXT_PUBLIC_WEB3FORMS_KEY_SALES=
NEXT_PUBLIC_WEB3FORMS_KEY_CONTACT=
NEXT_PUBLIC_WEB3FORMS_KEY_SUPPORT=
NEXT_PUBLIC_WEB3FORMS_KEY_BILLING=
NEXT_PUBLIC_WEB3FORMS_KEY_INVOICE=
NEXT_PUBLIC_WEB3FORMS_KEY_ADMIN=

# Also used by the testimonial form on /testimonials.
NEXT_PUBLIC_WEB3FORMS_KEY_HELLO=
